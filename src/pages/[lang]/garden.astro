---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBar from '../../components/SearchBar.astro';
import TagCloud from '../../components/TagCloud.astro';
import SortControl from '../../components/SortControl.astro';
import { getPublicArticles } from '../../lib/content';
import { loadTagRegistry, translateTag } from '../../lib/tags';
import { isValidLocale, type Locale } from '../../lib/i18n';
import { sortArticles } from '../../lib/sort';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
if (!isValidLocale(lang)) {
  return Astro.redirect('/es/');
}

const articles = await getPublicArticles(lang);
const registry = await loadTagRegistry();

const usedTagIds = new Set<string>();
for (const article of articles) {
  for (const tag of article.tags) {
    usedTagIds.add(tag);
  }
}

const tagList = Array.from(usedTagIds).map((id) => ({
  id,
  label: translateTag(id, lang, registry),
}));

tagList.sort((a, b) => a.label.localeCompare(b.label));

const initialSorted = sortArticles(articles, 'featured');
---

<BaseLayout lang={lang} title={lang === 'es' ? 'Garden' : 'Garden'} canonicalPath="garden" contentType="default">
  <h1 class="font-literata text-3xl md:text-4xl font-semibold leading-tight mb-8 text-ink">
    {lang === 'es' ? 'Garden' : 'Garden'}
  </h1>

  <div class="flex flex-col gap-4 mb-6">
    <SearchBar placeholder={lang === 'es' ? 'Buscar artículos...' : 'Search articles...'} />
    <SortControl lang={lang} />
    <TagCloud tags={tagList} lang={lang} />
  </div>

  <div id="article-count" class="nav-interface text-sm text-muted mb-6">
    {articles.length} {lang === 'es' ? 'artículos' : 'articles'}
  </div>

  <div id="article-list" class="flex flex-col gap-5">
    {initialSorted.map((article) => (
      <article
        class="article-card bg-surface border border-border rounded-md p-5 transition-colors hover:border-accent"
        data-article-id={article.articleId}
        data-tags={article.tags.join(',')}
        data-created={article.created.toISOString()}
        data-edited={article.edited.toISOString()}
        data-featured={article.featured ? 'true' : 'false'}
        data-title={article.title.toLowerCase()}
      >
        <a href={`/${lang}/${article.articleId}/`} class="block no-underline text-inherit hover:text-inherit">
          <h2 class="font-literata text-lg font-semibold leading-snug mb-2 text-ink">{article.title}</h2>
          <p class="text-sm leading-relaxed text-muted">{article.description}</p>
        </a>
        <div class="flex flex-wrap gap-2 mt-3">
          {article.tags.map((tag) => (
            <span class="nav-interface text-xs font-medium tracking-wide px-2 py-0.5 border border-border rounded-sm text-muted">
              {translateTag(tag, lang, registry)}
            </span>
          ))}
        </div>
        <div class="flex items-center gap-2 mt-2 nav-interface text-xs text-muted flex-wrap font-medium">
          <span>{new Date(article.created).toLocaleDateString(lang)}</span>
          {article.featured && (
            <span class="nav-interface text-xs font-semibold uppercase tracking-wider px-1.5 py-0.5 rounded-sm bg-accent-soft text-accent">
              {lang === 'es' ? 'Destacado' : 'Featured'}
            </span>
          )}
        </div>
      </article>
    ))}
  </div>

  <script>
    import MiniSearch from 'minisearch';

    document.addEventListener('DOMContentLoaded', () => {
      const articleList = document.getElementById('article-list');
      const countEl = document.getElementById('article-count');
      const sortSelect = document.getElementById('sort-select');
      const searchInput = document.getElementById('search-input');
      const tagButtons = document.querySelectorAll('.tag-button');

      let selectedTags = new Set<string>();
      let currentSort = 'featured';
      let currentQuery = '';
      let miniSearch: MiniSearch | null = null;
      let indexLoaded = false;
      let searchScores: Map<string, number> | null = null;

      async function ensureIndex() {
        if (indexLoaded) return;
        const lang = document.documentElement.lang;
        const response = await fetch(`/${lang}/search-index.json`);
        const jsonText = await response.text();
        miniSearch = MiniSearch.loadJSON(jsonText, {
          fields: ['title', 'description', 'tags', 'body'],
          storeFields: ['articleId', 'lang', 'title'],
        });
        indexLoaded = true;
      }

      async function updateSearchResults() {
        if (!currentQuery || currentQuery.length < 1) {
          searchScores = null;
          return;
        }
        await ensureIndex();
        const results = miniSearch!.search(currentQuery, {
          prefix: true,
          fuzzy: 0.2,
          boost: { title: 4, tags: 2.5, description: 1.5, body: 1 },
        });
        searchScores = new Map(results.map((r) => [r.articleId, r.score]));
      }

      function getCards() {
        return Array.from(articleList!.querySelectorAll('.article-card'));
      }

      function filterCards() {
        const cards = getCards();
        let visibleCount = 0;

        for (const card of cards) {
          const cardTags = card.dataset.tags ? card.dataset.tags.split(',') : [];
          const articleId = card.dataset.articleId!;

          const tagMatch = selectedTags.size === 0 || Array.from(selectedTags).every((t) => cardTags.includes(t));
          const searchMatch = searchScores === null || searchScores.has(articleId);

          const isVisible = tagMatch && searchMatch;
          (card as HTMLElement).style.display = isVisible ? '' : 'none';
          if (isVisible) visibleCount++;
        }

        if (countEl) {
          const lang = document.documentElement.lang;
          const plural = lang === 'es' ? 'artículos' : 'articles';
          countEl.textContent = visibleCount + ' ' + plural;
        }
      }

      function sortCards() {
        const cards = getCards();
        const visibleCards = cards.filter((c) => (c as HTMLElement).style.display !== 'none');

        visibleCards.sort((a, b) => {
          if (searchScores) {
            const scoreA = searchScores.get(a.dataset.articleId!) || 0;
            const scoreB = searchScores.get(b.dataset.articleId!) || 0;
            if (scoreB !== scoreA) {
              return scoreB - scoreA;
            }
          }

          switch (currentSort) {
            case 'created-asc':
              return new Date(a.dataset.created!).getTime() - new Date(b.dataset.created!).getTime();
            case 'created-desc':
              return new Date(b.dataset.created!).getTime() - new Date(a.dataset.created!).getTime();
            case 'edited-asc':
              return new Date(a.dataset.edited!).getTime() - new Date(b.dataset.edited!).getTime();
            case 'edited-desc':
              return new Date(b.dataset.edited!).getTime() - new Date(a.dataset.edited!).getTime();
            case 'alpha-asc':
              return (a.dataset.title || '').localeCompare(b.dataset.title || '');
            case 'alpha-desc':
              return (b.dataset.title || '').localeCompare(a.dataset.title || '');
            case 'featured':
              if (a.dataset.featured === 'true' && b.dataset.featured !== 'true') return -1;
              if (a.dataset.featured !== 'true' && b.dataset.featured === 'true') return 1;
              return new Date(b.dataset.created!).getTime() - new Date(a.dataset.created!).getTime();
            default:
              return 0;
          }
        });

        for (const card of visibleCards) {
          articleList!.appendChild(card);
        }
        for (const card of cards) {
          if ((card as HTMLElement).style.display === 'none') {
            articleList!.appendChild(card);
          }
        }
      }

      async function applyFilters() {
        await updateSearchResults();
        filterCards();
        sortCards();
      }

      for (const btn of tagButtons) {
        btn.addEventListener('click', () => {
          const tag = (btn as HTMLElement).dataset.tag!;
          if (selectedTags.has(tag)) {
            selectedTags.delete(tag);
            btn.classList.remove('active');
          } else {
            selectedTags.add(tag);
            btn.classList.add('active');
          }
          applyFilters();
        });
      }

      if (sortSelect) {
        sortSelect.addEventListener('change', (e) => {
          currentSort = (e.target as HTMLSelectElement).value;
          applyFilters();
        });
      }

      if (searchInput) {
        let debounceTimer: ReturnType<typeof setTimeout>;
        searchInput.addEventListener('input', (e) => {
          currentQuery = (e.target as HTMLInputElement).value;
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => {
            applyFilters();
          }, 50);
        });
      }
    });
  </script>
</BaseLayout>
