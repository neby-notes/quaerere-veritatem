---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicArticle, getPublicArticleConcepts } from '../../lib/content';
import { isValidLocale, type Locale } from '../../lib/i18n';
import { loadTagRegistry, translateTag } from '../../lib/tags';

export async function getStaticPaths() {
  const concepts = await getPublicArticleConcepts();
  const paths: Array<{ params: { lang: Locale; articleId: string } }> = [];

  for (const concept of concepts) {
    for (const lang of concept.availableLangs) {
      paths.push({
        params: { lang, articleId: concept.articleId },
      });
    }
  }

  return paths;
}

const { lang, articleId } = Astro.params;
if (!isValidLocale(lang)) {
  return Astro.redirect('/es/');
}

const article = await getPublicArticle(articleId, lang);
if (!article) {
  return Astro.redirect(`/${lang}/`);
}

const registry = await loadTagRegistry();
const translatedTags = article.tags.map((tag) => ({
  id: tag,
  label: translateTag(tag, lang, registry),
}));
---

<BaseLayout
  lang={lang}
  title={article.title}
  description={article.description}
  articleId={articleId}
  canonicalPath={articleId}
  contentType="article"
>
  <article class="pt-2">
    <header class="border-b border-border mb-10 pb-8">
      <h1 class="font-literata text-3xl md:text-4xl font-semibold leading-tight mb-3 text-ink">{article.title}</h1>
      <p class="text-lg leading-relaxed text-muted mb-5 max-w-[60ch]">{article.description}</p>
      <div class="nav-interface text-sm text-muted flex items-center gap-2 flex-wrap font-medium">
        <span>{lang === 'es' ? 'Por' : 'By'} {article.author}</span>
        <span class="opacity-50">•</span>
        <time datetime={article.created.toISOString()}>
          {new Date(article.created).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
      {translatedTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {translatedTags.map((tag) => (
            <a
              href={`/${lang}/garden?tag=${tag.id}`}
              class="nav-interface text-xs font-medium tracking-wide px-2 py-1 border border-border rounded-sm text-muted hover:text-accent hover:border-accent transition-colors no-underline"
            >
              {tag.label}
            </a>
          ))}
        </div>
      )}
      {article.heroImage && (
        <img
          src={article.heroImage}
          alt={article.title}
          class="mt-6 w-full max-h-96 object-cover rounded-md"
        />
      )}
    </header>

    <div class="text-[1.05rem] leading-[1.72]">
      <div set:html={article.body} />
    </div>

    {translatedTags.length > 0 && (
      <footer class="border-t border-border mt-12 pt-6">
        <div class="flex flex-wrap gap-2">
          {translatedTags.map((tag) => (
            <a
              href={`/${lang}/garden?tag=${tag.id}`}
              class="nav-interface text-xs font-medium tracking-wide px-2 py-1 border border-border rounded-sm text-muted hover:text-accent hover:border-accent transition-colors no-underline"
            >
              {tag.label}
            </a>
          ))}
        </div>
      </footer>
    )}
  </article>
</BaseLayout>
