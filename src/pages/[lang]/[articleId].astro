---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublicArticle, getPublicArticleConcepts, getRelatedArticles } from '../../lib/content';
import { isValidLocale, type Locale } from '../../lib/i18n';
import { loadTagRegistry, translateTag, getTagOrder, sortTagsByCanonicalOrder } from '../../lib/tags';

export async function getStaticPaths() {
  const concepts = await getPublicArticleConcepts();
  const paths: Array<{ params: { lang: Locale; articleId: string } }> = [];

  for (const concept of concepts) {
    for (const lang of concept.availableLangs) {
      paths.push({
        params: { lang, articleId: concept.articleId },
      });
    }
  }

  return paths;
}

const { lang, articleId } = Astro.params;
if (!isValidLocale(lang)) {
  return Astro.redirect('/es/');
}

const article = await getPublicArticle(articleId, lang);
if (!article) {
  return Astro.redirect(`/${lang}/`);
}

const registry = await loadTagRegistry();
const relatedArticles = await getRelatedArticles(articleId, lang, 5);
const tagOrder = getTagOrder(registry);
const translatedTags = sortTagsByCanonicalOrder(
  article.tags.map((tag) => ({
    id: tag,
    label: translateTag(tag, lang, registry),
  })),
  tagOrder
);
const site = 'https://quaerere-veritatem.pages.dev';
const articleUrl = `${site}/${lang}/${articleId}/`.replace(/(https?:)\/+/g, '$1//').replace(/([^:])\/+/g, '$1/');

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.description,
  author: {
    '@type': 'Person',
    name: article.author,
  },
  datePublished: article.created.toISOString().split('T')[0],
  dateModified: article.edited.toISOString().split('T')[0],
  inLanguage: lang,
  url: articleUrl,
  ...(article.heroImage ? { image: article.heroImage } : {}),
};
---

<BaseLayout
  lang={lang}
  title={article.title}
  description={article.description}
  articleId={articleId}
  canonicalPath={articleId}
  contentType="article"
  image={article.heroImage}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

  <article class="pt-2">
    <header class="border-b border-border mb-10 pb-8">
      <h1 class="font-literata text-3xl md:text-4xl font-semibold leading-tight mb-3 text-ink">{article.title}</h1>
      <p class="text-lg leading-relaxed text-muted mb-5 max-w-[60ch]">{article.description}</p>
      <div class="nav-interface text-sm text-muted flex items-center gap-2 flex-wrap font-medium">
        <span>{lang === 'es' ? 'Por' : 'By'} {article.author}</span>
        <span class="opacity-50">•</span>
        <time datetime={article.created.toISOString()}>
          {new Date(article.created).toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </div>
      {translatedTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {translatedTags.map((tag) => (
            <a
              href={`/${lang}/garden?tag=${tag.id}`}
              class="nav-interface text-xs font-medium tracking-wide px-2 py-1 border border-border rounded-sm text-muted hover:text-accent hover:border-accent transition-colors no-underline"
            >
              {tag.label}
            </a>
          ))}
        </div>
      )}
      {article.heroImage && (
        <img
          src={article.heroImage}
          alt={article.title}
          class="mt-6 w-full max-h-96 object-cover rounded-md"
          loading="lazy"
          decoding="async"
        />
      )}
    </header>

    <div class="text-[1.05rem] leading-[1.72] article-body">
      <div set:html={article.body} />
    </div>

    <script is:inline>
      (function() {
        var container = document.querySelector('.article-body');
        if (!container) return;
        var headings = container.querySelectorAll('h2, h3, h4');
        if (headings.length < 3) return;
        var toc = document.createElement('nav');
        toc.className = 'toc border border-border rounded-md p-4 bg-surface mb-10';
        toc.setAttribute('aria-label', 'Table of contents');
        var title = document.createElement('p');
        title.className = 'nav-interface text-sm font-semibold text-ink mb-3';
        title.textContent = document.documentElement.lang === 'es' ? 'En esta página' : 'On this page';
        toc.appendChild(title);
        var list = document.createElement('ul');
        list.className = 'space-y-1.5';
        headings.forEach(function(heading) {
          if (!heading.id) return;
          var li = document.createElement('li');
          var a = document.createElement('a');
          a.href = '#' + heading.id;
          a.textContent = heading.textContent;
          a.className = 'text-sm text-muted hover:text-accent transition-colors no-underline';
          if (heading.tagName === 'H3') a.classList.add('ml-4');
          if (heading.tagName === 'H4') a.classList.add('ml-8');
          li.appendChild(a);
          list.appendChild(li);
        });
        toc.appendChild(list);
        container.parentNode.insertBefore(toc, container);
      })();
    </script>

    {translatedTags.length > 0 && (
      <footer class="border-t border-border mt-12 pt-6">
        <div class="flex flex-wrap gap-2">
          {translatedTags.map((tag) => (
            <a
              href={`/${lang}/garden?tag=${tag.id}`}
              class="nav-interface text-xs font-medium tracking-wide px-2 py-1 border border-border rounded-sm text-muted hover:text-accent hover:border-accent transition-colors no-underline"
            >
              {tag.label}
            </a>
          ))}
        </div>
      </footer>
    )}

    {relatedArticles.length > 0 && (
      <aside class="mt-14 border-t border-border pt-8">
        <h2 class="font-literata text-xl md:text-2xl font-semibold mb-6 text-ink">
          {lang === 'es' ? 'Artículos relacionados' : 'Related articles'}
        </h2>
        <div class="flex flex-col gap-4">
          {relatedArticles.map((related) => (
            <article class="border-b border-border pb-4 last:border-0">
              <a href={`/${lang}/${related.articleId}/`} class="block no-underline text-inherit hover:text-inherit">
                <h3 class="font-literata text-base font-semibold leading-snug mb-1 text-ink">{related.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{related.description}</p>
              </a>
            </article>
          ))}
        </div>
      </aside>
    )}
  </article>
</BaseLayout>
