---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLandingContent, getFeaturedArticles, getLatestArticles } from '../../lib/content';
import { isValidLocale, type Locale } from '../../lib/i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
if (!isValidLocale(lang)) {
  return Astro.redirect('/es/');
}

const landing = await getLandingContent(lang);
const featured = await getFeaturedArticles(lang);
const latest = await getLatestArticles(lang, 5);
---

<BaseLayout lang={lang} title={landing?.title} canonicalPath="">
  <article class="prose dark:prose-invert max-w-none">
    <div set:html={landing?.body} />
  </article>

  {featured.length > 0 && (
    <section class="mt-12">
      <h2 class="text-2xl font-serif font-bold mb-6">{lang === 'es' ? 'Artículos destacados' : 'Featured articles'}</h2>
      <div class="grid gap-6">
        {featured.map((article) => (
          <article class="border border-stone-200 dark:border-stone-800 rounded-lg p-6">
            <a href={`/${lang}/${article.articleId}/`} class="block group">
              <h3 class="text-xl font-bold group-hover:underline">{article.title}</h3>
              <p class="mt-2 text-stone-600 dark:text-stone-400">{article.description}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="mt-12">
      <h2 class="text-2xl font-serif font-bold mb-6">{lang === 'es' ? 'Últimos artículos' : 'Latest articles'}</h2>
      <div class="grid gap-4">
        {latest.map((article) => (
          <article>
            <a href={`/${lang}/${article.articleId}/`} class="block group">
              <h3 class="text-lg font-semibold group-hover:underline">{article.title}</h3>
              <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">{article.description}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}
</BaseLayout>