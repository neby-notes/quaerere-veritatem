---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLandingContent, getFeaturedArticles, getLatestArticles } from '../../lib/content';
import { isValidLocale, type Locale } from '../../lib/i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
if (!isValidLocale(lang)) {
  return Astro.redirect('/es/');
}

const landing = await getLandingContent(lang);
const featured = await getFeaturedArticles(lang);
const latest = await getLatestArticles(lang, 10);

const site = 'https://quaerere-veritatem.pages.dev';
const landingUrl = `${site}/${lang}/`.replace(/(https?:)\/+/g, '$1//').replace(/([^:])\/+/g, '$1/');

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Quaerere Veritatem',
  url: landingUrl,
  inLanguage: lang,
  author: { '@type': 'Person', name: 'NEBY' },
};
---

<BaseLayout lang={lang} title={landing?.title} contentType="landing">
  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

  <div class="pt-4">
    {landing?.title && (
      <h1 class="font-literata font-semibold text-ink leading-tight mb-10"
          style="font-size: clamp(2.5rem, 6vw, 3.75rem);">
        {landing.title}
      </h1>
    )}
    {landing?.body && (
      <div class="mb-14">
        <div set:html={landing.body} />
      </div>
    )}

    {featured.length > 0 && (
      <section class="mb-14">
        <h2 class="font-literata text-xl md:text-2xl font-semibold mb-6 pb-3 border-b border-border text-ink">
          {lang === 'es' ? 'Artículos destacados' : 'Featured articles'}
        </h2>
        <div class="grid gap-6 grid-cols-1 sm:grid-cols-2">
          {featured.map((article) => (
            <article class="bg-surface border border-border rounded-md p-5 transition-colors hover:border-accent">
              <a href={`/${lang}/${article.articleId}/`} class="block no-underline text-inherit hover:text-inherit">
                <h3 class="font-literata text-lg font-semibold leading-snug mb-2 text-ink">{article.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{article.description}</p>
              </a>
            </article>
          ))}
          <article class="border border-dashed border-border rounded-md p-5 transition-colors hover:border-accent flex items-center justify-center">
            <a href={`/${lang}/garden?sort=featured`} class="block no-underline text-inherit hover:text-inherit text-center">
              <span class="font-literata text-base font-semibold text-muted">
                {lang === 'es' ? 'Ver más artículos destacados →' : 'See more featured articles →'}
              </span>
            </a>
          </article>
        </div>
      </section>
    )}

    {latest.length > 0 && (
      <section class="mb-14">
        <h2 class="font-literata text-xl md:text-2xl font-semibold mb-6 pb-3 border-b border-border text-ink">
          {lang === 'es' ? 'Últimos artículos' : 'Latest articles'}
        </h2>
        <div class="flex flex-col gap-4">
          {latest.map((article) => (
            <article class="border-b border-border pb-4">
              <a href={`/${lang}/${article.articleId}/`} class="block no-underline text-inherit hover:text-inherit">
                <h3 class="font-literata text-base font-semibold leading-snug mb-1 text-ink">{article.title}</h3>
                <p class="text-sm leading-relaxed text-muted">{article.description}</p>
              </a>
            </article>
          ))}
          <article class="pt-2">
            <a href={`/${lang}/garden?sort=edited-desc`} class="block no-underline text-inherit hover:text-inherit">
              <span class="font-literata text-base font-semibold text-muted">
                {lang === 'es' ? 'Ver más artículos →' : 'See more articles →'}
              </span>
            </a>
          </article>
        </div>
      </section>
    )}
  </div>
</BaseLayout>
