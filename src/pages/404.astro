---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="es" title="404" contentType="default">
  <div class="flex flex-col items-center justify-center min-h-[50vh] text-center px-5">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="mb-6 text-ink w-12 h-12" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M50 18 C45 14, 30 12, 20 16 C15 18, 12 22, 12 28 L12 72 C12 78, 15 80, 20 78 C30 74, 45 74, 50 78 C55 74, 70 74, 80 78 C85 80, 88 78, 88 72 L88 28 C88 22, 85 18, 80 16 C70 12, 55 14, 50 18 Z" />
      <line x1="50" y1="18" x2="50" y2="78" />
      <line x1="20" y1="30" x2="44" y2="30" stroke-width="3.5" />
      <line x1="20" y1="38" x2="44" y2="38" stroke-width="3.5" />
      <line x1="20" y1="46" x2="44" y2="46" stroke-width="3.5" />
      <line x1="56" y1="30" x2="80" y2="30" stroke-width="3.5" />
      <line x1="56" y1="38" x2="80" y2="38" stroke-width="3.5" />
      <line x1="56" y1="46" x2="80" y2="46" stroke-width="3.5" />
    </svg>

    <h1 class="font-literata font-semibold text-ink leading-tight mb-4" style="font-size: clamp(2rem, 5vw, 3rem);">404</h1>

    <p id="message-es" class="text-muted text-lg mb-2 max-w-md">
      La página que buscas no existe o ha cambiado de lugar.
    </p>
    <p id="message-en" class="text-muted text-lg mb-8 max-w-md hidden">
      The page you are looking for does not exist or has moved.
    </p>

    <div class="flex items-center gap-4 nav-interface text-sm">
      <a href="/es/" id="home-es" class="text-accent hover:text-accent-hover no-underline font-medium">Volver al inicio →</a>
      <a href="/en/" id="home-en" class="text-accent hover:text-accent-hover no-underline font-medium hidden">Back to home →</a>
    </div>
  </div>

  <script is:inline>
    (function() {
      var navLang = navigator.language || navigator.userLanguage || 'es';
      var isEn = navLang.toLowerCase().startsWith('en');
      if (isEn) {
        document.getElementById('message-en').classList.remove('hidden');
        document.getElementById('message-es').classList.add('hidden');
        document.getElementById('home-en').classList.remove('hidden');
        document.getElementById('home-es').classList.add('hidden');
      }
    })();
  </script>
</BaseLayout>
