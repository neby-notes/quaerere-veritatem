---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="es" title="Quaerere Veritatem" contentType="landing">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-5">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="48" height="48" class="mb-6 text-ink" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M50 18 C45 14, 30 12, 20 16 C15 18, 12 22, 12 28 L12 72 C12 78, 15 80, 20 78 C30 74, 45 74, 50 78 C55 74, 70 74, 80 78 C85 80, 88 78, 88 72 L88 28 C88 22, 85 18, 80 16 C70 12, 55 14, 50 18 Z" />
      <line x1="50" y1="18" x2="50" y2="78" />
      <line x1="20" y1="30" x2="44" y2="30" stroke-width="3.5" />
      <line x1="20" y1="38" x2="44" y2="38" stroke-width="3.5" />
      <line x1="20" y1="46" x2="44" y2="46" stroke-width="3.5" />
      <line x1="56" y1="30" x2="80" y2="30" stroke-width="3.5" />
      <line x1="56" y1="38" x2="80" y2="38" stroke-width="3.5" />
      <line x1="56" y1="46" x2="80" y2="46" stroke-width="3.5" />
    </svg>

    <h1 class="font-literata font-semibold text-ink leading-tight mb-4"
        style="font-size: clamp(2rem, 5vw, 3rem);">
      Quaerere Veritatem
    </h1>

    <p class="text-muted text-lg mb-8 max-w-md">
      Digital garden polimático dedicado a la búsqueda de la verdad.
      <br />
      Polymathic digital garden dedicated to the pursuit of truth.
    </p>

    <div class="flex items-center gap-4 nav-interface text-sm text-muted">
      <span id="redirect-status">Detectando idioma… / Detecting language…</span>
    </div>

    <noscript>
      <meta http-equiv="refresh" content="0;url=/es/" />
    </noscript>
  </div>

  <script is:inline>
    (function() {
      var navLang = navigator.language || navigator.userLanguage || 'es';
      var target = navLang.toLowerCase().startsWith('en') ? '/en/' : '/es/';
      var status = document.getElementById('redirect-status');
      if (status) {
        status.textContent = navLang.toLowerCase().startsWith('en')
          ? 'Redirecting to English…'
          : 'Redirigiendo al español…';
      }
      window.location.replace(target);
    })();
  </script>
</BaseLayout>