---
interface Props {
  tags: Array<{ id: string; label: string }>;
  lang: string;
}

const { tags, lang } = Astro.props;
---

<div class="flex flex-col gap-2">
  <p class="nav-interface text-sm font-medium text-muted">
    {lang === 'es' ? 'Filtrar por tags:' : 'Filter by tags:'}
  </p>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <button
        type="button"
        data-tag={tag.id}
        class="tag-button nav-interface text-xs font-medium tracking-wide px-2.5 py-1 border border-border rounded-sm text-muted hover:text-accent hover:border-accent transition-colors cursor-pointer bg-transparent"
      >
        {tag.label}
      </button>
    ))}
  </div>
</div>

<style>
  .tag-button.active {
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
