---
---

<button
  id="theme-toggle"
  class="nav-interface flex items-center border border-border rounded overflow-hidden hover:border-accent transition-colors bg-transparent"
  aria-label="Toggle dark mode"
  type="button"
>
  <span id="toggle-light" class="px-2 py-[0.35rem] min-w-[2.5rem] flex items-center justify-center leading-none transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </svg>
  </span>
  <span id="toggle-dark" class="px-2 py-[0.35rem] min-w-[2.5rem] flex items-center justify-center leading-none transition-colors border-l border-border">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </span>
</button>

<script is:inline>
  (function() {
    const toggle = document.getElementById('theme-toggle');
    const lightSpan = document.getElementById('toggle-light');
    const darkSpan = document.getElementById('toggle-dark');
    if (!toggle || !lightSpan || !darkSpan) return;

    function setActive(el) {
      el.classList.add('bg-accent', 'text-paper');
      el.classList.remove('text-muted', 'hover:bg-surface', 'hover:text-ink');
    }

    function setInactive(el) {
      el.classList.remove('bg-accent', 'text-paper');
      el.classList.add('text-muted', 'hover:bg-surface', 'hover:text-ink');
    }

    function updateVisuals() {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        setActive(darkSpan);
        setInactive(lightSpan);
      } else {
        setActive(lightSpan);
        setInactive(darkSpan);
      }
    }

    updateVisuals();

    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateVisuals();
    });
  })();
</script>
