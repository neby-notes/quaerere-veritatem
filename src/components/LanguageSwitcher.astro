---
import type { Locale } from '../lib/i18n';

interface Props {
  currentLang: Locale;
  articleId?: string;
  translationMap: Record<string, Locale[]>;
}

const { currentLang, articleId, translationMap } = Astro.props;

const alternateLang: Locale = currentLang === 'es' ? 'en' : 'es';
let targetUrl: string;

if (articleId && translationMap[articleId]?.includes(alternateLang)) {
  targetUrl = `/${alternateLang}/${articleId}/`;
} else {
  targetUrl = `/${alternateLang}/`;
}
---

<a
  href={targetUrl}
  class="text-sm font-medium px-2 py-1 rounded border border-stone-300 dark:border-stone-700 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors"
>
  {alternateLang.toUpperCase()}
</a>