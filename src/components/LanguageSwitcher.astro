---
import type { Locale } from '../lib/i18n';

interface Props {
  currentLang: Locale;
  articleId?: string;
  canonicalPath?: string;
  translationMap: Record<string, Locale[]>;
}

const { currentLang, articleId, canonicalPath = '', translationMap } = Astro.props;

const alternateLang: Locale = currentLang === 'es' ? 'en' : 'es';
let targetUrl: string;

if (articleId && translationMap[articleId]?.includes(alternateLang)) {
  targetUrl = `/${alternateLang}/${articleId}/`;
} else if (canonicalPath) {
  targetUrl = `/${alternateLang}/${canonicalPath}/`;
} else {
  targetUrl = `/${alternateLang}/`;
}

const labels = { es: 'ES', en: 'EN' };
---

<a
  href={targetUrl}
  class="nav-interface flex items-center border border-border rounded overflow-hidden text-xs font-semibold tracking-wider uppercase no-underline hover:border-accent transition-colors"
  aria-label={`Switch to ${alternateLang}`}
>
  <span class={`px-2.5 py-[0.35rem] min-w-[2.5rem] text-center leading-none transition-colors ${currentLang === 'es' ? 'bg-accent text-paper' : 'text-muted hover:bg-surface hover:text-ink'}`}>
    {labels.es}
  </span>
  <span class={`px-2.5 py-[0.35rem] min-w-[2.5rem] text-center leading-none transition-colors border-l border-border ${currentLang === 'en' ? 'bg-accent text-paper' : 'text-muted hover:bg-surface hover:text-ink'}`}>
    {labels.en}
  </span>
</a>
