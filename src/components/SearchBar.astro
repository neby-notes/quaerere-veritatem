---
interface Props {
  placeholder?: string;
}

const { placeholder = 'Buscar...' } = Astro.props;
---

<div class="w-full">
  <input
    id="search-input"
    type="text"
    class="nav-interface w-full px-4 py-2 text-sm bg-surface text-ink border border-border rounded-md outline-none transition-colors focus:border-accent placeholder:text-muted"
    placeholder={placeholder}
    autocomplete="off"
  />
</div>
