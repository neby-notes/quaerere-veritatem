---
interface Props {
  placeholder?: string;
}

const { placeholder = 'Buscar...' } = Astro.props;
---

<div class="w-full">
  <input
    id="search-input"
    type="text"
    class="w-full px-4 py-2 rounded-lg border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 focus:outline-none focus:ring-2 focus:ring-stone-500"
    placeholder={placeholder}
    autocomplete="off"
  />
</div>