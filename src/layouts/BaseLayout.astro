---
import '../styles/global.css';
import { getTranslationMap, type Locale } from '../lib/i18n';
import { getPublicArticleConcepts } from '../lib/content';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  lang: Locale;
  articleId?: string;
  canonicalPath?: string;
  contentType?: 'landing' | 'about' | 'article' | 'default';
}

const { title, description, lang, articleId, canonicalPath = '', contentType = 'default' } = Astro.props;
const site = 'https://quaerere-veritatem.pages.dev';
const pageTitle = title ? `${title} — Quaerere Veritatem` : 'Quaerere Veritatem';
const canonical = `${site}/${lang}/${canonicalPath}/`.replace(/(https?:)\/+/g, '$1//').replace(/([^:])\/+/g, '$1/');

const concepts = await getPublicArticleConcepts();
const translationMap = getTranslationMap(concepts);

const alternateLangs: Locale[] = ['es', 'en'];
const hreflangLinks = alternateLangs.map((l) => {
  let path = '';
  if (articleId && translationMap[articleId]?.includes(l)) {
    path = `${articleId}/`;
  } else if (!articleId) {
    path = canonicalPath ? `${canonicalPath}/` : '';
  }
  return {
    lang: l,
    url: `${site}/${l}/${path}`.replace(/(https?:)\/+/g, '$1//').replace(/([^:])\/+/g, '$1/'),
  };
}).filter((link) => {
  if (articleId) {
    return translationMap[articleId]?.includes(link.lang);
  }
  return true;
});

if (hreflangLinks.length > 0) {
  const defaultLink = hreflangLinks.find((l) => l.lang === 'es') ?? hreflangLinks[0];
  hreflangLinks.push({
    lang: 'x-default',
    url: defaultLink.url,
  });
}

const currentPath = Astro.url.pathname;
const navItems = [
  { href: `/${lang}/`, label: 'Home' },
  { href: `/${lang}/garden`, label: 'Garden' },
  { href: `/${lang}/about`, label: 'About' },
];

function isActive(href: string): boolean {
  const cleanCurrent = currentPath.replace(/\/+$/, '') || '/';
  const cleanHref = href.replace(/\/+$/, '') || '/';
  return cleanCurrent === cleanHref;
}
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;0,7..72,700;1,7..72,400&display=swap" rel="stylesheet">
    <link rel="canonical" href={canonical} />
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.url} />
    ))}
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <header class="border-b border-border">
      <div class="max-w-5xl mx-auto px-5 py-4 flex items-center justify-between">
        <a 
          href={`/${lang}/`} 
          class="flex items-center gap-3 text-ink hover:opacity-80 transition-opacity"
          style="font-family: var(--font-baskerville);"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="28" height="28" class="shrink-0 self-center" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M50 18 C45 14, 30 12, 20 16 C15 18, 12 22, 12 28 L12 72 C12 78, 15 80, 20 78 C30 74, 45 74, 50 78 C55 74, 70 74, 80 78 C85 80, 88 78, 88 72 L88 28 C88 22, 85 18, 80 16 C70 12, 55 14, 50 18 Z" />
            <line x1="50" y1="18" x2="50" y2="78" />
            <line x1="20" y1="30" x2="44" y2="30" stroke-width="4" />
            <line x1="20" y1="38" x2="44" y2="38" stroke-width="4" />
            <line x1="20" y1="46" x2="44" y2="46" stroke-width="4" />
            <line x1="56" y1="30" x2="80" y2="30" stroke-width="4" />
            <line x1="56" y1="38" x2="80" y2="38" stroke-width="4" />
            <line x1="56" y1="46" x2="80" y2="46" stroke-width="4" />
          </svg>
          <span class="text-[1.20rem] font-semibold underline underline-offset-[0.16em] decoration-1 leading-none">Quaerere Veritatem</span>
        </a>
        <div class="flex items-center gap-5">
          <nav class="hidden sm:flex items-center gap-6 text-sm nav-interface">
            {navItems.map((item) => (
              <a
                href={item.href}
                class={`text-muted no-underline font-medium transition-colors hover:text-accent ${isActive(item.href) ? 'text-ink font-semibold border-b-2 border-accent' : ''}`}
              >
                {item.label}
              </a>
            ))}
          </nav>
          <div class="hidden sm:block w-px h-5 bg-border opacity-50 mx-0.5"></div>
          <div class="flex items-center gap-2">
            <LanguageSwitcher currentLang={lang} articleId={articleId} canonicalPath={canonicalPath} translationMap={translationMap} />
            <ThemeToggle />
          </div>
          <button
            id="mobile-menu-toggle"
            class="sm:hidden nav-interface p-1 text-muted hover:text-ink transition-colors"
            aria-label="Toggle navigation menu"
            type="button"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
      <div id="mobile-menu" class="hidden sm:hidden border-t border-border">
        <nav class="flex flex-col px-5 py-3 gap-3 nav-interface">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`text-sm text-muted no-underline font-medium transition-colors hover:text-accent py-1 ${isActive(item.href) ? 'text-ink font-semibold border-l-2 border-accent pl-3' : 'pl-3'}`}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <script is:inline>
      (function() {
        const toggle = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('mobile-menu');
        if (!toggle || !menu) return;
        toggle.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      })();
    </script>

    <main class={`flex-1 w-full ${contentType === 'article' ? 'max-w-[68ch] mx-auto px-5 pt-10 pb-16' : contentType === 'about' ? 'max-w-[72ch] mx-auto px-5 pt-12 pb-16' : contentType === 'landing' ? 'max-w-[80ch] mx-auto px-5 pt-12 pb-16' : 'max-w-[80ch] mx-auto px-5 pt-8 pb-16'}`}>
      <slot />
    </main>

    <footer class="border-t border-border">
      <div class="max-w-5xl mx-auto px-5 py-6 text-center text-sm text-muted nav-interface">
        <p>Quaerere Veritatem — <em>Veritas liberavit vos</em></p>
      </div>
    </footer>
  </body>
</html>
