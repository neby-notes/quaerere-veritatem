---
import '../styles/global.css';
import { getTranslationMap, type Locale } from '../lib/i18n';
import { getPublicArticleConcepts } from '../lib/content';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  lang: Locale;
  articleId?: string;
  canonicalPath?: string;
}

const { title, description, lang, articleId, canonicalPath = '' } = Astro.props;
const site = 'https://quaerere-veritatem.pages.dev';
const pageTitle = title ? `${title} — Quaerere Veritatem` : 'Quaerere Veritatem';
const canonical = `${site}/${lang}/${canonicalPath}/`.replace(/\/+/g, '/');

const concepts = await getPublicArticleConcepts();
const translationMap = getTranslationMap(concepts);

// Generate hreflang links
const alternateLangs: Locale[] = ['es', 'en'];
const hreflangLinks = alternateLangs.map((l) => {
  let path = '';
  if (articleId && translationMap[articleId]?.includes(l)) {
    path = `${articleId}/`;
  } else if (!articleId) {
    path = canonicalPath ? `${canonicalPath}/` : '';
  }
  return {
    lang: l,
    url: `${site}/${l}/${path}`.replace(/\/+/g, '/'),
  };
}).filter((link) => {
  // Only include links that make sense: if articleId exists, only include langs that have translation
  if (articleId) {
    return translationMap[articleId]?.includes(link.lang);
  }
  return true;
});

// Add x-default
if (hreflangLinks.length > 0) {
  const defaultLink = hreflangLinks.find((l) => l.lang === 'es') ?? hreflangLinks[0];
  hreflangLinks.push({
    lang: 'x-default',
    url: defaultLink.url,
  });
}
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.url} />
    ))}
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body class="bg-white text-stone-900 dark:bg-stone-900 dark:text-stone-100 min-h-screen flex flex-col">
    <header class="border-b border-stone-200 dark:border-stone-800">
      <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href={`/${lang}/`} class="text-xl font-serif font-bold tracking-tight hover:opacity-80 transition-opacity">
          Quaerere Veritatem
        </a>
        <div class="flex items-center gap-4">
          <nav class="flex items-center gap-4 text-sm">
            <a href={`/${lang}/`} class="hover:underline">Home</a>
            <a href={`/${lang}/garden`} class="hover:underline">Garden</a>
            <a href={`/${lang}/about`} class="hover:underline">About</a>
          </nav>
          <LanguageSwitcher currentLang={lang} articleId={articleId} translationMap={translationMap} />
          <ThemeToggle />
        </div>
      </div>
    </header>
    <main class="flex-1 max-w-4xl mx-auto w-full px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-stone-200 dark:border-stone-800 py-6 text-center text-sm text-stone-500">
      <p>Quaerere Veritatem — <em>Veritas liberavit vos</em></p>
    </footer>
  </body>
</html>